# Supabase — local values come from `pnpm exec supabase status` after `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Needed for writing official recipes (is_official) in later phases.
SUPABASE_SECRET_KEY=

# Local/CI only: shows an email+password login on /login for testing. Never set this in Vercel.
# NEXT_PUBLIC_DEV_LOGIN=1
